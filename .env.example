# ==============================================================================
# YUOP Streetwear — متغيرات البيئة (Local Dev + Cloudflare Workers Secrets)
# هام: لا تضع أي مفاتيح حقيقية في هذا الملف أو في الكود الأمامي (Frontend).
# في الإنتاج على Cloudflare Workers، اضبط القيم الحساسة عبر:
#   npx wrangler secret put <SECRET_NAME>
# أو في التطوير المحلي مع Wrangler داخل ملف .dev.vars (مشمول في .gitignore).
# ==============================================================================

# رابط التطبيق العام (Worker URL أو الدومين المخصص لبناء رابط Webhook الرسمي)
APP_URL="http://localhost:3000"

# مفتاح تشفير وتوقيع جلسات لوحة التحكم (يُولّد عشوائيًا بطول 64 محرفًا في الإنتاج)
SESSION_SECRET="replace-with-strong-random-64-char-secret"

# رمز سري اختياري لحماية صفحة تأسيس حساب المدير الأول (/api/admin/auth/setup)
# إذا تُرك فارغًا في أول تشغيل، يُسمح بإنشاء أول حساب Super Admin لمرة واحدة فقط ثم يُقفل تلقائيًا.
ADMIN_SETUP_TOKEN=""

# للتطوير المحلي على Node.js فقط (server.ts):
DATABASE_PATH="./data/yuop.db"
UPLOADS_DIR="./uploads/receipts"
# فعّل true فقط إذا كنت تريد بذر حسابات وطلبات تجريبية محليًا أثناء التطوير (ممنوع في الإنتاج):
ALLOW_DEV_SEED="false"

# ==============================================================================
# إعدادات WhatsApp Cloud API الرسمي من Meta (Cloudflare Secrets)
# https://developers.facebook.com/apps
# ==============================================================================
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"

# ==============================================================================
# خدمة البريد الإلكتروني عبر HTTP API المتوافقة مع Cloudflare Workers (اختياري)
# يدعم النظام Resend (100/يوم مجانًا) أو Brevo (300/يوم مجانًا) عبر fetch() بدون SMTP.
# ==============================================================================
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM="orders@your-verified-domain.com"
EMAIL_FROM_NAME="YUOP Streetwear"
