# ==============================================================================
# YUOP Streetwear — ملف متغيرات البيئة (Environment Variables)
# هام: لا تضع أي مفاتيح سرية حقيقية داخل الكود الأمامي (Frontend).
# ==============================================================================

# رابط التطبيق العام (يستخدم لبناء رابط Webhook الرسمي)
APP_URL="https://your-domain.com"

# مفتاح تشفير جلسات الموظفين في لوحة التحكم (يجب تغييره في بيئة الإنتاج)
SESSION_SECRET="change-this-to-a-strong-random-64-char-secret"

# مسار قاعدة البيانات ومجلد حفظ صور الإيصالات (يمكن تغييره حسب الاستضافة)
DATABASE_PATH="./data/yuop.db"
UPLOADS_DIR="./uploads/receipts"

# ==============================================================================
# إعدادات WhatsApp Cloud API الرسمي من Meta (مباشرة بدون وسطاء مدفوعين)
# يتم الحصول عليها من: https://developers.facebook.com/apps
# ==============================================================================
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"

# ==============================================================================
# إعدادات Gmail SMTP لإرسال إيميلات الطلبات (مجاني ضمن حدود Gmail اليومية)
# يتطلب تفعيل App Password من حساب Google
# ==============================================================================
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM_NAME="YUOP Streetwear"
